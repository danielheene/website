# Database
# MongoDB connection string (e.g. mongodb://127.0.0.1:27017/website)
DATABASE_URL=mongodb://127.0.0.1:27017/website

# Payload CMS
# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to preview drafts
PREVIEW_SECRET=YOUR_SECRET_HERE

# Used to trigger cron tasks
CRON_SECRET=YOUR_SECRET_HERE

# Your server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Redis (for KV adapter)
REDIS_URL=redis://127.0.0.1:6379

# S3 Storage (Minio in local dev)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=website
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000

# Email (UseSend - Optional)
USESEND_API_KEY=
USESEND_URL=
USESEND_DEFAULT_FROM_ADDRESS=
USESEND_DEFAULT_FROM_NAME=

# Analytics (Umami - Optional)
UMAMI_HOST_URL=
UMAMI_WEBSITE_ID=
