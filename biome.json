{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "./packages/biome-config/base.jsonc"
  ],
  "files": {
    "includes": [
      "/*.js",
      "/*.jsx",
      "/*.ts",
      "/*.tsx",
      "/*.json",
      "**/*.js",
      "**/*.jsx",
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "**/*.jsonc",
      "**/*.css",

      "!!**/dist",
      "!!**/build",
      "!!**/.cache",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/node_modules",
      "!!**/coverage",
      "!!**/playwright-report",
      "!!**/test-results"
    ],
    "ignoreUnknown": false
  }
}
