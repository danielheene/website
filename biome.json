{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "./packages/biome-config/base.jsonc"
  ],
  "files": {
    "includes": [
      "/*.js",
      "/*.jsx",
      "/*.ts",
      "/*.tsx",
      "/*.json",
      "**/*.js",
      "**/*.jsx",
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "/src/**/*",
      "/app/**",
      "/public/**",

      "!!**/dist",
      "!!**/build",
      "!!**/.cache"
    ],
    "ignoreUnknown": false
  }
}
