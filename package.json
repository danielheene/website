    "embla-carousel-react": "^8.6.0",
    "hash-wasm": "^4.12.0",
    "hyphen": "^1.14.1",
    "isomorphic-dompurify": "^4.3.0",
    "jose": "^6.2.12",
    "jsdom": "^30.1.1",
    "libphonenumber-js": "^1.13.14",
    "lodash-es": "^4.18.1",
    "mediabunny": "^1.59.1",
    "nanoid": "^6.0.1",
    "neotraverse": "^1.0.1",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "payload": "^3.90.1",
    "pdf-parse": "^2.4.5",
    "pretty-ms": "^9.3.1",
    "pupa": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "recharts": "^3.10.1",
    "redis": "6.2.1",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "svgo": "^4.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.14.0",
    "timestring": "^7.0.0",
    "type-fest": "^5.10.0",
