{
  "name": "website",
  "version": "1.0.0",
  "private": "true",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild:app": "pnpm run payload migrate:create",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "build:app": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "build:storybook": "cross-env NODE_OPTIONS=--no-deprecation storybook build",
    "chore": "pnpm run --parallel \"/^chore:.*/\"",
    "chore:reinstall": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "chore:sort": "pnpm dlx sort-package-json",
    "ci": "printenv && payload migrate && pnpm build",
    "dev": "pnpm run --parallel \"/^dev:.*/\"",
    "dev:app": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:storybook": "cross-env NODE_OPTIONS=--no-deprecation storybook dev -p 6006",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "load-env": "pnpm run load-env:clean && pnpm run load-env:download",
    "load-env:clean": "pnpm -c exec \"rm -f .env .env.load || true\"",
    "load-env:download": "DOPPLER_CONFIG=development_personal doppler secrets download --format env --no-file > .env.local || true",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
