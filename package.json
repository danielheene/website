    "playwright": "~1.63.0",
    "postcss": "^8.5.28",
    "react-docgen-typescript": "^2.4.0",
    "semantic-release": "^25.0.9",
    "serve": "^14.2.6",
    "storybook": "^10.6.0",
    "styled-jsx": "^5.1.7",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.139.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "^1.4.0",
    "node": "^26.0.0"
  },
  "patchedDependencies": {
    "pdfjs-dist@5.4.296": "patches/pdfjs-dist@5.4.296.patch"
