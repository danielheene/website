{
  "name": "website",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "turbo run build:storybook",
    "ci": "turbo run migrate build",
    "ci:publish": "pnpm publish -r",
    "chore:reinstall": "pnpm --shell-mode exec rm -rf node_modules && pnpm --shell-mode exec rm pnpm-lock.yaml && pnpm install",
    "chore:sort": "sort-package-json",
    "deps:fix": "syncpack fix --dependency-types prod,dev,peer",
    "deps:lint": "syncpack lint --dependency-types prod,dev,peer",
    "deps:update": "syncpack update",
    "dev": "turbo run dev:app dev:storybook",
    "dev:app": "turbo run dev:app",
    "dev:storybook": "turbo run dev:storybook",
    "format": "biome format --write",
    "generate": "turbo run generate",
    "lint": "biome check",
    "migrate": "turbo run migrate",
    "prepare": "husky",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "resolutions": {
    "@emnapi/runtime": "^2.0.0-alpha",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "redis": "4.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "sort-package-json": "^4.0.0",
    "syncpack": "^15.3.2",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^26.0.0",
    "pnpm": "^11.0.0"
  }
}
