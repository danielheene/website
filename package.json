{
  "name": "website",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#payload.css": "./src/styles/payload.css",
    "#frontend.css": "./src/styles/frontend.css"
  },
  "scripts": {
    "build": "SENTRY_RELEASE=\"${SENTRY_RELEASE:-website@$(node -p 'require(\"./package.json\").version')}\" pnpm run next build",
    "build:storybook": "storybook build -o dist",
    "chore:reinstall": "pnpm --shell-mode exec rm -rf node_modules && pnpm --shell-mode exec rm pnpm-lock.yaml && pnpm install",
    "chore:sort": "sort-package-json",
    "ci": "pnpm run migrate && pnpm run build",
    "deps:fix": "syncpack fix --dependency-types prod,dev,peer",
    "deps:lint": "syncpack lint --dependency-types prod,dev,peer",
    "deps:update": "syncpack update",
    "dev": "node --run dev:app:next",
    "dev:app": "node --run dev:app:next",
    "dev:app:next": "NODE_OPTIONS=\"--trace-deprecation --disable-warning=DeprecationWarning\" node scripts/dev.mjs",
    "dev:storybook": "pnpm run storybook dev -p 6006",
    "format": "biome format --write",
    "generate": "pnpm run generate:types && pnpm run generate:importmap",
    "generate:importmap": "pnpm run payload generate:importmap",
    "generate:types": "pnpm run payload generate:types",
    "lint": "biome check",
    "load-env": "node scripts/load-env.mjs",
    "links:migrate": "pnpm run payload run scripts/migrate-link-fields.ts",
    "migrate": "pnpm run payload migrate",
    "migrate:create:dev": "MIGRATION_DIR=migrations/dev pnpm run payload migrate:create",
    "migrate:create:required": "pnpm run payload migrate:create",
    "migrate:dev": "pnpm run migrate && MIGRATION_DIR=migrations/dev pnpm run payload migrate",
    "next": "NODE_OPTIONS=\"--trace-deprecation --disable-warning=DeprecationWarning\" next",
    "payload": "NODE_OPTIONS=\"--trace-deprecation --disable-warning=DeprecationWarning\" payload",
    "prepare": "husky",
    "refs:backfill": "pnpm run payload run scripts/backfill-references.ts",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "seed": "pnpm run seed:blog",
    "seed:blog": "pnpm run payload run scripts/seed-blog.ts",
    "seed:blog:clean": "pnpm run payload run scripts/seed-blog.ts -- --clean",
    "skills:migrate-content-caption": "pnpm run payload run scripts/migrate-skill-content-caption.ts",
    "start": "pnpm run next start",
    "start:job-runner": "pnpm run payload jobs:run --cron \"* * * * *\" --all-queues --handle-schedules --limit 10",
    "storybook": "NODE_OPTIONS=\"--trace-deprecation --disable-warning=DeprecationWarning\" storybook",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --env-file=.env.test node_modules/@playwright/test/cli.js test",
    "test:e2e:docker": "./scripts/e2e-docker.sh",
    "test:e2e:ui": "node --env-file=.env.test node_modules/@playwright/test/cli.js test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.26",
    "@iconify/react": "^6.0.2",
    "@mediabunny/server": "^1.52.2",
    "@napi-rs/canvas": "^1.0.3",
    "@payloadcms/db-mongodb": "^3.87.0",
    "@payloadcms/kv-redis": "^3.87.0",
    "@payloadcms/live-preview-react": "^3.87.0",
    "@payloadcms/next": "^3.87.0",
    "@payloadcms/plugin-import-export": "^3.87.0",
    "@payloadcms/richtext-lexical": "^3.87.0",
    "@payloadcms/storage-s3": "^3.87.0",
    "@payloadcms/translations": "^3.87.0",
    "@payloadcms/ui": "^3.87.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "^4.5.1",
    "@react-pdf/types": "^2.11.1",
    "@sindresorhus/slugify": "^3.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@trieb.work/nextjs-turbo-redis-cache": "^1.17.0",
    "ai": "^7.0.45",
    "date-fns": "^4.4.0",
    "dedent": "^1.7.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hash-wasm": "^4.12.0",
    "hyphen": "^1.14.1",
    "isomorphic-dompurify": "^3.22.0",
    "jsdom": "^30.0.1",
    "libphonenumber-js": "^1.13.10",
    "lodash-es": "^4.18.1",
    "mediabunny": "^1.52.2",
    "nanoid": "^6.0.0",
    "neotraverse": "^1.0.1",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "payload": "^3.87.0",
    "pdf-parse": "^2.4.5",
    "pretty-ms": "^9.3.0",
    "pupa": "^3.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "recharts": "^3.10.1",
    "redis": "4.7.0",
    "schema-dts": "^2.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "shiki": "^4.4.1",
    "svgo": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.0",
    "takumi-js": "^2.5.4",
    "timestring": "^7.0.0",
    "type-fest": "^5.7.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@payloadcms/plugin-sentry": "^3.87.0",
    "@playwright/test": "~1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sentry/nextjs": "^10.69.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-onboarding": "^10.5.5",
    "@storybook/addon-themes": "^10.5.5",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
    "@storybook/nextjs": "^10.5.5",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/hyphen": "^1.14.0",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/timestring": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.3",
    "cssnano": "^8.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "next": "^16.2.12",
    "playwright": "~1.62.1",
    "postcss": "^8.5.25",
    "react": "^19.2.7",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.2.7",
    "semantic-release": "^25.0.9",
    "sort-package-json": "^4.0.0",
    "storybook": "^10.5.5",
    "styled-jsx": "^5.1.7",
    "syncpack": "^15.3.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "resolutions": {
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "redis": "4.7.0"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^26.0.0",
    "pnpm": "^11.0.0"
  }
}
