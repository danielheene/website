{
  "name": "website",
  "version": "1.15.2-rc.5",
  "private": true,
  "description": "personal website, blog, and resume builder",
  "homepage": "https://daniel.heene.io",
  "repository": "https://github.com/danielheene/website",
  "license": "MIT",
  "author": {
    "name": "Daniel Heene",
    "email": "daniel@heene.io"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=@website/backend",
    "build:frontend": "turbo run build --filter=@website/frontend",
    "build:storybook": "turbo run build --filter=@website/storybook",
    "chore:format": "syncpack format",
    "chore:reinstall": "rm -rf node_modules bun.lock && bun install",
    "ci": "bun run migrate && bun run build",
    "deps:fix": "syncpack fix --dependency-types prod,dev,peer",
    "deps:lint": "syncpack lint --dependency-types prod,dev,peer",
    "deps:update": "syncpack update",
    "dev": "turbo run dev --filter=@website/backend --filter=@website/frontend",
    "dev:all": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@website/backend",
    "dev:frontend": "turbo run dev --filter=@website/frontend",
    "dev:storybook": "turbo run dev --filter=@website/storybook",
    "dev:tunnel": "node scripts/tunnel.mjs --with-dev",
    "format": "turbo run format",
    "generate": "turbo run generate",
    "generate:importmap": "turbo run generate:importmap",
    "generate:types": "turbo run generate:types",
    "links:migrate": "cd apps/backend && bun run links:migrate",
    "lint": "turbo run lint",
    "lint:backend": "turbo run lint --filter=@website/backend",
    "lint:fix": "turbo run lint:fix",
    "lint:frontend": "turbo run lint --filter=@website/frontend",
    "lint:storybook": "turbo run lint --filter=@website/storybook",
    "load-env": "node scripts/load-env.mjs",
    "migrate": "cd apps/backend && bun run migrate",
    "prepare": "lefthook install",
    "refs:backfill": "cd apps/backend && bun run refs:backfill",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "seed:frontend-access": "cd apps/backend && bun run seed:frontend-access",
    "seed:pages": "cd apps/backend && bun run seed:pages",
    "seed:pages:clean": "cd apps/backend && bun run seed:pages:clean",
    "seed:posts": "cd apps/backend && bun run seed:posts",
    "seed:posts:clean": "cd apps/backend && bun run seed:posts:clean",
    "seed:resume-documents": "cd apps/backend && bun run seed:resume-documents",
    "seed:resume-documents:clean": "cd apps/backend && bun run seed:resume-documents:clean",
    "seed:topics": "cd apps/backend && bun run seed:topics",
    "seed:topics:clean": "cd apps/backend && bun run seed:topics:clean",
    "start:app": "cd apps/backend && bun run start",
    "start:storybook": "cd apps/storybook && bun run start",
    "start:worker": "cd apps/backend && bun run start:worker",
    "test": "turbo run test",
    "test:backend": "turbo run test --filter=@website/backend",
    "test:coverage": "turbo run test:coverage",
    "test:coverage:backend": "turbo run test:coverage --filter=@website/backend",
    "test:coverage:frontend": "turbo run test:coverage --filter=@website/frontend",
    "test:e2e": "node --env-file=.env.test node_modules/@playwright/test/cli.js test",
    "test:e2e:docker": "./scripts/e2e-docker.sh",
    "test:e2e:ui": "node --env-file=.env.test node_modules/@playwright/test/cli.js test --ui",
    "test:frontend": "turbo run test --filter=@website/frontend",
    "test:watch": "turbo run test:watch --filter=@website/frontend",
    "tunnel": "node scripts/tunnel.mjs",
    "typecheck": "turbo run typecheck",
    "typecheck:backend": "turbo run typecheck --filter=@website/backend",
    "typecheck:frontend": "turbo run typecheck --filter=@website/frontend",
    "typecheck:storybook": "turbo run typecheck --filter=@website/storybook"
  },
  "overrides": {
    "@emnapi/runtime": "^2.0.0-alpha",
    "dompurify": "^3.4.16",
    "pdfjs-dist": "5.4.296",
    "postcss-merge-rules": "9.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "6.2.1",
    "sharp": "^0.35.4"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@oxlint/plugins": "^1.86.0",
    "@playwright/test": "~1.63.0",
    "@react-email/ui": "^6.11.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/hyphen": "^1.14.0",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/timestring": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.0.5",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tailwindcss": "^1.16.0",
    "playwright": "~1.63.0",
    "postcss": "^8.5.28",
    "react-docgen-typescript": "^2.4.0",
    "semantic-release": "^25.0.9",
    "serve": "^14.2.6",
    "styled-jsx": "^5.1.7",
    "syncpack": "^15.3.3",
    "tailwind-merge": "^3.7.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.139.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "^1.4.0",
    "node": "^26.0.0"
  },
  "patchedDependencies": {
    "pdfjs-dist@5.4.296": "patches/pdfjs-dist@5.4.296.patch"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "@swc/core",
    "core-js-pure",
    "esbuild",
    "lefthook",
    "mongodb-memory-server",
    "node-av",
    "sharp",
    "unrs-resolver",
    "workerd"
  ]
}
