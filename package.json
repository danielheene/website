    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/hyphen": "^1.14.0",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/timestring": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "cssnano": "^8.0.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "playwright": "~1.63.0",
    "postcss": "^8.5.28",
    "react": "^19.2.7",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.2.7",
    "semantic-release": "^25.0.9",
    "serve": "^14.2.6",
    "storybook": "^10.6.0",
    "styled-jsx": "^5.1.7",
    "syncpack": "^15.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^26.0.0",
    "pnpm": "^11.0.0"
  },
  "readme": "https://github.com/danielheene/website"
}
