{
  "name": "website",
  "version": "1.0.0",
  "private": "true",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' next build",
    "chore:reinstall": "pnpm dlx cross-env NODE_OPTIONS='--no-deprecation --no-warnings' rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "chore:sort": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' sort-package-json",
    "ci": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' payload migrate && pnpm build",
    "ci:publish": "pnpm publish -r",
    "dev": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' next dev --turbopack",
    "generate": "pnpm run --parallel \"/^generate:.*/\" payload",
    "generate:importmap": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' payload generate:types",
    "ii": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' next lint",
    "lint:fix": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' next lint --fix",
    "payload": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' payload",
    "load-env": "doppler setup && pnpm run load-env:clean && pnpm run load-env:download",
    "load-env:clean": "pnpm -c exec \"rm -f .env .env.local || true\"",
    "load-env:download": "doppler secrets download --format env --no-file > .env.local || true",
    "start": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' next start"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.72.0",
    "@payloadcms/kv-redis": "^3.72.0",
    "@payloadcms/live-preview-react": "^3.72.0",
    "@payloadcms/next": "^3.72.0",
    "@payloadcms/plugin-nested-docs": "^3.72.0",
    "@payloadcms/storage-s3": "^3.72.0",
    "@payloadcms/plugin-search": "^3.72.0",
    "@payloadcms/plugin-seo": "^3.72.0",
    "@payloadcms/richtext-lexical": "^3.72.0",
