{
  "name": "website",
  "version": "1.4.1",
  "private": true,
  "description": "personal website, blog, and resume builder",
  "homepage": "https://daniel.heene.io",
  "repository": "https://github.com/danielheene/website",
  "license": "MIT",
  "author": {
    "name": "Daniel Heene",
    "email": "daniel@heene.io"
  },
  "type": "module",
  "imports": {
    "#payload.css": "./src/styles/payload.css",
    "#frontend.css": "./src/styles/frontend.css"
  },
  "scripts": {
    "build": "pnpm run next build",
    "build:storybook": "pnpm run storybook build --output-dir dist",
    "chore:reinstall": "pnpm --shell-mode exec rm -rf node_modules && pnpm --shell-mode exec rm pnpm-lock.yaml && pnpm install",
    "chore:format": "syncpack format",
    "ci": "pnpm run migrate && pnpm run build",
    "deps:fix": "syncpack fix --dependency-types prod,dev,peer",
    "deps:lint": "syncpack lint --dependency-types prod,dev,peer",
    "deps:update": "syncpack update",
    "dev": "NODE_OPTIONS=\"--trace-deprecation --disable-warning=DeprecationWarning\" node scripts/dev.mjs",
    "dev:app": "pnpm run next dev",
    "dev:storybook": "pnpm run storybook dev -p 6006",
    "email:dev": "email dev --dir src/emails --port 3005",
    "format": "biome format --write",
    "generate": "pnpm run generate:types && pnpm run generate:importmap",
    "generate:importmap": "pnpm run payload generate:importmap",
    "generate:types": "pnpm run payload generate:types",
    "links:migrate": "pnpm run payload run scripts/migrate-link-field-naming.ts",
    "lint": "biome check",
    "load-env": "node scripts/load-env.mjs",
    "migrate": "pnpm run payload migrate",
    "next": "NODE_OPTIONS=\"--trace-deprecation --disable-warning=DeprecationWarning\" next",
    "payload": "NODE_OPTIONS=\"--trace-deprecation --disable-warning=DeprecationWarning\" payload",
    "prepare": "husky",
    "refs:backfill": "pnpm run payload run scripts/backfill-references.ts",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "seed:pages": "pnpm run payload run scripts/seed-pages.ts",
    "seed:pages:clean": "pnpm run payload run scripts/seed-pages.ts -- --clean",
    "seed:posts": "pnpm run payload run scripts/seed-posts.ts",
    "seed:posts:clean": "pnpm run payload run scripts/seed-posts.ts -- --clean",
    "seed:topics": "pnpm run payload run scripts/seed-topics.ts",
    "seed:topics:clean": "pnpm run payload run scripts/seed-topics.ts -- --clean",
    "start:storybook": "serve dist -l 3020",
    "start": "pnpm run next start",
    "start:worker": "node scripts/start-worker.mjs",
    "storybook": "NODE_OPTIONS=\"--trace-deprecation --disable-warning=DeprecationWarning\" storybook",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --env-file=.env.test node_modules/@playwright/test/cli.js test",
    "test:e2e:docker": "./scripts/e2e-docker.sh",
    "test:e2e:ui": "node --env-file=.env.test node_modules/@playwright/test/cli.js test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "resolutions": {
    "pdfjs-dist": "5.4.296"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.58",
    "@iconify/react": "^6.0.2",
    "@mediabunny/server": "^1.58.1",
    "@napi-rs/canvas": "^1.0.9",
    "@paper-design/shaders-react": "^0.0.81",
    "@payloadcms/db-mongodb": "^3.88.0",
    "@payloadcms/kv-redis": "^3.88.0",
    "@payloadcms/live-preview-react": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/plugin-import-export": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@payloadcms/translations": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "^4.9.0",
    "@react-pdf/types": "^2.14.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "ai": "^7.0.107",
    "date-fns": "^4.4.0",
    "dedent": "^1.7.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hash-wasm": "^4.12.0",
    "hyphen": "^1.14.1",
