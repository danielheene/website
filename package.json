    "@payloadcms/eslint-config": "^3.28.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jsdom": "^27.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.9",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.3",
