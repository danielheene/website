{
  "name": "website",
  "version": "1.12.3",
  "private": true,
  "description": "personal website, blog, and resume builder",
  "homepage": "https://daniel.heene.io",
  "repository": "https://github.com/danielheene/website",
  "license": "MIT",
  "author": {
    "name": "Daniel Heene",
    "email": "daniel@heene.io"
  },
  "type": "module",
  "imports": {
    "#payload.css": "./src/styles/payload.css",
    "#frontend.css": "./src/styles/frontend.css"
  },
  "scripts": {
    "build": "bun run _next build",
    "build:storybook": "bun run _storybook build --output-dir dist",
    "chore:reinstall": "rm -rf node_modules bun.lock && bun install",
    "chore:format": "syncpack format",
    "ci": "bun run migrate && bun run build",
    "deps:fix": "syncpack fix --dependency-types prod,dev,peer",
    "deps:lint": "syncpack lint --dependency-types prod,dev,peer",
    "deps:update": "syncpack update",
    "dev": "NODE_OPTIONS=\"--import tsx/esm --trace-deprecation --disable-warning=DeprecationWarning\" node scripts/dev.mjs",
    "dev:app": "bun run _next dev",
    "dev:storybook": "bun run _storybook dev -p 6006",
    "dev:email": "bun run _email dev --dir src/emails --port 3005",
    "format": "oxfmt",
    "generate": "bun run generate:types && bun run generate:importmap",
    "generate:importmap": "bun run _payload generate:importmap",
    "generate:types": "bun run _payload generate:types",
    "links:migrate": "bun run _payload run scripts/migrate-link-field-naming.ts",
    "lint": "oxlint && oxfmt --check",
    "load-env": "node scripts/load-env.mjs",
    "migrate": "bun run _payload migrate",
    "_next": "NODE_OPTIONS=\"--import tsx/esm --trace-deprecation --disable-warning=DeprecationWarning\" next",
    "_payload": "NODE_OPTIONS=\"--import tsx/esm --trace-deprecation --disable-warning=DeprecationWarning\" payload --disable-transpile",
    "_email": "NODE_OPTIONS=\"--trace-deprecation --disable-warning=DeprecationWarning\" email",
    "_storybook": "NODE_OPTIONS=\"--trace-deprecation --disable-warning=DeprecationWarning\" storybook",
    "prepare": "lefthook install",
    "refs:backfill": "bun run _payload run scripts/backfill-references.ts",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "seed:pages": "bun run _payload run scripts/seed-pages.ts",
    "seed:pages:clean": "bun run _payload run scripts/seed-pages.ts -- --clean",
    "seed:posts": "bun run _payload run scripts/seed-posts.ts",
    "seed:posts:clean": "bun run _payload run scripts/seed-posts.ts -- --clean",
    "seed:resume-documents": "bun run _payload run scripts/seed-resume-documents.ts",
    "seed:resume-documents:clean": "bun run _payload run scripts/seed-resume-documents.ts -- --clean",
    "seed:topics": "bun run _payload run scripts/seed-topics.ts",
    "seed:topics:clean": "bun run _payload run scripts/seed-topics.ts -- --clean",
    "start:storybook": "npx serve dist -l 3020",
    "start:app": "bun run _next start",
    "start:worker": "node scripts/start-worker.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --env-file=.env.test node_modules/@playwright/test/cli.js test",
    "test:e2e:docker": "./scripts/e2e-docker.sh",
    "test:e2e:ui": "node --env-file=.env.test node_modules/@playwright/test/cli.js test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:fix": "oxlint --fix && oxfmt"
  },
  "overrides": {
    "@emnapi/runtime": "^2.0.0-alpha",
    "dompurify": "^3.4.16",
    "pdfjs-dist": "5.4.296",
    "postcss-merge-rules": "9.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "6.2.1",
    "sharp": "^0.35.4"
  },
