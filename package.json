  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm run next build",
    "chore:reinstall": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "chore:sort": "sort-package-json",
    "ci": "pnpm migrate && pnpm build",
    "ci:publish": "pnpm publish -r",
    "dev": "pnpm run next dev",
    "generate": "pnpm run --parallel \"/^generate:.*/\"",
    "generate:importmap": "pnpm run payload -- generate:importmap",
    "generate:types": "payload generate:types",
    "migrate": "pnpm run payload migrate",
    "next": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' next",
    "payload": "cross-env NODE_OPTIONS='--no-deprecation --no-warnings' payload",
    "start": "pnpm run next start"
  },
