{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@imgs/*": [
        "./public/payload/blocks/*"
      ],
      "@payload-config": [
        "./src/payload.config.ts"
      ],
      "@payload-types": [
        "./src/payload-types.ts"
      ],
      "@custom-types": [
        "./src/custom-types.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "@styles/*": [
        "./src/styles/*"
      ],
      "@fonts/*": [
        "./public/fonts/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": false,
    "target": "esnext"
  },
  "exclude": [
    "node_modules",
    ".next"
  ],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.ts",
    ".next/dev/types/**/*.ts"
  ]
}
