{
  "name": "@danielheene/font-pp-supply-mono",
  "type": "module",
  "exports": {
    "./next": "./src/next.ts",
    "./pdf": "./src/pdf.ts"
  },
  "sideEffects": false,
  "peerDependencies": {
    "next": ">=15"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "next": "^16.2.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "pnpm run compile --clean",
    "compile": "tsup src/next.ts src/pdf.ts --format cjs,esm --minify --keep-names --dts",
    "dev": "pnpm run compile --watch"
  }
}
