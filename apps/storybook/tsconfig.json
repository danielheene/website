{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@website/components": [
        "../../packages/components/src"
      ],
      "@website/font-pp-frama": [
        "../../packages/font-pp-frama"
      ],
      "@website/font-pp-frama-text": [
        "../../packages/font-pp-frama-text"
      ],
      "@website/font-pp-supply-mono": [
        "../../packages/font-pp-supply-mono"
      ],
      "@website/font-pp-supply-sans": [
        "../../packages/font-pp-supply-sans"
      ],
      "@website/styles": [
        "../../packages/styles"
      ],
      "@website/styles/*": [
        "../../packages/styles/*"
      ],
      "@website/storybook/*": [
        "./*"
      ]
    }
  },
  "include": [
    "css.d.ts",
    "main.ts",
    "preview.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "foundations/**/*.ts",
    "foundations/**/*.tsx",
    "foundations/**/*.mdx",
    "shaders/**/*.ts",
    "shaders/**/*.tsx",
    "shaders/**/*.mdx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}