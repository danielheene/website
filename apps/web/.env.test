# Test environment — committed on purpose.
# Dummy but format-valid values that satisfy src/types/environment.ts so the
# app can boot for E2E tests. Flows depending on real external services will
# not work with these: AI generation (OpenAI/Anthropic), Mapbox geocoding,
# email (UseSend), Umami analytics, status-page heartbeat.
# Prerequisite: `docker compose up -d` (Mongo, Redis, S3 must be reachable).

NODE_ENV=test

SERVER_HOST=localhost:3000
SERVER_URL=http://localhost:3000
STATUS_PAGE_URL=http://localhost:3001
STATUS_PAGE_HEARTBEAT_URL=http://localhost:3001/api/push/test

PAYLOAD_SECRET=test-payload-secret-not-for-production
PREVIEW_SECRET=test-preview-secret
CRON_SECRET=test-cron-secret

DATABASE_URL=mongodb://127.0.0.1:27017/website-test
REDIS_URL=redis://127.0.0.1:6379

S3_BUCKET=website
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_ENDPOINT=http://localhost:9000

UMAMI_USERNAME=test
UMAMI_PASSWORD=test
NEXT_PUBLIC_UMAMI_URL=http://localhost:3002
NEXT_PUBLIC_UMAMI_SITE_ID=00000000-0000-4000-8000-000000000000

USESEND_URL=http://localhost:3003
USESEND_API_KEY=test-key
USESEND_DEFAULT_FROM_ADDRESS=test@example.com
USESEND_DEFAULT_FROM_NAME=Test

OPENAI_API_KEY=sk-test
ANTHROPIC_API_KEY=sk-ant-test
MAPBOX_API_KEY=pk.test
