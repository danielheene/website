{
  "name": "@website/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#backend.css": "./app/backend.css"
  },
  "scripts": {
    "_next": "NODE_OPTIONS=\"--import tsx/esm --trace-deprecation --disable-warning=DeprecationWarning\" next",
    "_payload": "NODE_OPTIONS=\"--import tsx/esm --trace-deprecation --disable-warning=DeprecationWarning\" payload --disable-transpile",
    "build": "bun run _next build",
    "dev": "NODE_OPTIONS=\"--import tsx/esm --trace-deprecation --disable-warning=DeprecationWarning\" node scripts/dev.mjs -p 3100",
    "format": "oxfmt",
    "generate:importmap": "bun run _payload generate:importmap",
    "generate:types": "bun run _payload generate:types",
    "links:migrate": "bun run _payload run scripts/migrate-link-field-naming.ts",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "migrate": "bun run _payload migrate",
    "refs:backfill": "bun run _payload run scripts/backfill-references.ts",
    "seed:frontend-access": "bun run _payload run scripts/seed-frontend-access.ts",
    "seed:pages": "bun run _payload run scripts/seed-pages.ts",
    "seed:pages:clean": "bun run _payload run scripts/seed-pages.ts -- --clean",
    "seed:posts": "bun run _payload run scripts/seed-posts.ts",
    "seed:posts:clean": "bun run _payload run scripts/seed-posts.ts -- --clean",
    "seed:resume-documents": "bun run _payload run scripts/seed-resume-documents.ts",
    "seed:resume-documents:clean": "bun run _payload run scripts/seed-resume-documents.ts -- --clean",
    "seed:topics": "bun run _payload run scripts/seed-topics.ts",
    "seed:topics:clean": "bun run _payload run scripts/seed-topics.ts -- --clean",
    "start": "bun run _next start",
    "start:worker": "node scripts/start-worker.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.63",
    "@iconify/react": "^6.0.2",
    "@mediabunny/server": "^1.59.1",
    "@napi-rs/canvas": "^1.0.9",
    "@payloadcms/db-mongodb": "^3.90.1",
    "@payloadcms/kv-redis": "^3.90.1",
    "@payloadcms/live-preview-react": "^3.90.1",
    "@payloadcms/next": "^3.90.1",
    "@payloadcms/plugin-import-export": "^3.90.1",
    "@payloadcms/plugin-sentry": "^3.90.1",
    "@payloadcms/richtext-lexical": "^3.90.1",
    "@payloadcms/storage-s3": "^3.90.1",
    "@payloadcms/translations": "^3.90.1",
    "@payloadcms/ui": "^3.90.1",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "^4.9.0",
    "@react-pdf/types": "^2.14.0",
    "@sentry/nextjs": "^11.0.0",
    "@sentry/node": "^11.0.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@website/app-components": "workspace:*",
    "@website/components": "workspace:*",
    "@website/font-pp-frama": "workspace:*",
    "@website/font-pp-frama-text": "workspace:*",
    "@website/font-pp-supply-mono": "workspace:*",
    "@website/font-pp-supply-sans": "workspace:*",
    "@website/lib": "workspace:*",
    "@website/types": "workspace:*",
    "ai": "^7.0.107",
    "date-fns": "^4.4.0",
    "dedent": "^1.7.2",
    "embla-carousel-react": "^8.6.0",
    "hash-wasm": "^4.12.0",
    "hyphen": "^1.14.1",
    "libphonenumber-js": "^1.13.14",
    "lodash-es": "^4.18.1",
    "mediabunny": "^1.59.1",
    "nanoid": "^6.0.1",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "payload": "^3.90.1",
    "pdf-parse": "^2.4.5",
    "pretty-ms": "^9.3.1",
    "pupa": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "recharts": "^3.10.1",
    "redis": "6.2.1",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "svgo": "^4.1.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "timestring": "^7.0.0",
    "type-fest": "^5.10.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
