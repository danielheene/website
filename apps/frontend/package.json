{
  "name": "@website/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#frontend.css": "./frontend.css"
  },
  "scripts": {
    "_next": "NODE_OPTIONS=\"--import tsx/esm --trace-deprecation --disable-warning=DeprecationWarning\" next",
    "build": "bun run _next build",
    "dev": "NODE_OPTIONS=\"--import tsx/esm --trace-deprecation --disable-warning=DeprecationWarning\" node scripts/dev.mjs",
    "format": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "start": "bun run _next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@payloadcms/richtext-lexical": "^3.90.1",
    "@payloadcms/ui": "^3.90.1",
    "@react-pdf/renderer": "^4.9.0",
    "@react-pdf/types": "^2.14.0",
    "@sentry/nextjs": "^11.0.0",
    "@toolwind/corner-shape": "^0.0.8-3",
    "@website/app-components": "workspace:*",
    "@website/components": "workspace:*",
    "@website/font-pp-frama": "workspace:*",
    "@website/font-pp-frama-text": "workspace:*",
    "@website/font-pp-supply-mono": "workspace:*",
    "@website/font-pp-supply-sans": "workspace:*",
    "@website/lib": "workspace:*",
    "@website/types": "workspace:*",
    "date-fns": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hash-wasm": "^4.12.0",
    "hyphen": "^1.14.1",
    "libphonenumber-js": "^1.13.14",
    "lodash-es": "^4.18.1",
    "nanoid": "^6.0.1",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "payload": "^3.90.1",
    "pupa": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "6.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.14.0",
    "tw-easing-gradients": "^1.2.0",
    "type-fest": "^5.10.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
