{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "ANALYZE",
    "CI"
  ],
  "globalPassThroughEnv": [
    "NODE_OPTIONS"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "NEXT_RUNTIME",
        "REDIS_DATABASE",
        "REDIS_KEY_PREFIX",
        "REDIS_TIMEOUT_MS",
        "SERVER_HOST",
        "SERVER_URL",
        "STATUS_PAGE_URL",
        "STATUS_PAGE_HEARTBEAT_URL",
        "PAYLOAD_SECRET",
        "PREVIEW_SECRET",
        "CRON_SECRET",
        "DATABASE_URL",
        "REDIS_URL",
        "S3_BUCKET",
        "S3_SECRET_KEY",
        "S3_REGION",
        "S3_ACCESS_KEY",
        "S3_ENDPOINT",
        "UMAMI_USERNAME",
        "UMAMI_PASSWORD",
        "NEXT_PUBLIC_UMAMI_URL",
        "NEXT_PUBLIC_UMAMI_SITE_ID",
        "USESEND_URL",
        "USESEND_API_KEY",
        "USESEND_DEFAULT_FROM_ADDRESS",
        "USESEND_DEFAULT_FROM_NAME",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_RELEASE",
        "SENTRY_TRACES_SAMPLE_RATE",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "NEXT_PUBLIC_SENTRY_REPLAY_RATE",
        "NEXT_PUBLIC_SENTRY_REPLAY_ERROR_RATE",
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "MAPBOX_API_KEY",
        "CLOUDFLARE_TUNNEL_HOST",
        "CLOUDFLARE_TUNNEL_URL",
        "CLOUDFLARE_TUNNEL_TOKEN"
      ]
    },

    "build:storybook": {
      "outputs": [
        "dist/**"
      ],
      "env": [
        "SERVER_HOST",
        "SERVER_URL",
        "STATUS_PAGE_URL",
        "STATUS_PAGE_HEARTBEAT_URL",
        "PAYLOAD_SECRET",
        "PREVIEW_SECRET",
        "CRON_SECRET",
        "DATABASE_URL",
        "REDIS_URL",
        "S3_BUCKET",
        "S3_SECRET_KEY",
        "S3_REGION",
        "S3_ACCESS_KEY",
        "S3_ENDPOINT",
        "UMAMI_USERNAME",
        "UMAMI_PASSWORD",
        "NEXT_PUBLIC_UMAMI_URL",
        "NEXT_PUBLIC_UMAMI_SITE_ID",
        "USESEND_URL",
        "USESEND_API_KEY",
        "USESEND_DEFAULT_FROM_ADDRESS",
        "USESEND_DEFAULT_FROM_NAME",
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "MAPBOX_API_KEY"
      ]
    },

    "//#transit": {},

    "lint": {
      "dependsOn": [
        "//#transit"
      ]
    },

    "typecheck": {
      "dependsOn": [
        "//#transit"
      ],
      "outputs": [
        "*.tsbuildinfo"
      ]
    },

    "test": {
      "dependsOn": [
        "//#transit"
      ],
      "outputs": []
    },

    "test:coverage": {
      "dependsOn": [
        "//#transit"
      ],
      "outputs": [
        "coverage/**"
      ]
    },

    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "env": [
        "PORT",
        "E2E_BASE_URL",
        "E2E_NO_SERVER"
      ]
    },

    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },

    "dev:app": {
      "cache": false,
      "persistent": true,
      "env": [
        "DEV_TUNNEL",
        "CLOUDFLARE_TUNNEL_HOST",
        "CLOUDFLARE_TUNNEL_URL",
        "CLOUDFLARE_TUNNEL_TOKEN"
      ]
    },

    "dev:storybook": {
      "cache": false,
      "persistent": true
    },

    "generate": {
      "dependsOn": [
        "generate:types",
        "generate:importmap"
      ],
      "cache": false
    },

    "generate:types": {
      "cache": false,
      "outputs": [
        "src/types/payload.ts"
      ]
    },

    "generate:importmap": {
      "cache": false,
      "outputs": [
        "app/(payload)/admin/importMap.js"
      ]
    },

    "migrate": {
      "cache": false
    }
  }
}
